  id: Enemy_Pickpocket
  enemyName: "\uC18C\uB9E4\uCE58\uAE30\uBC94"
  tier: 2
  description: "\uC9C0\uC544\uC758 \uC637 \uC8FC\uBA38\uB2C8\uC5D0\uC11C \uC9C0\uAC11,
    \uD578\uB4DC\uD3F0\uC744 \uD6D4\uCE5C \uB3C4\uB451"
  maxBaseHealth: 300
  behaviourDescriptionList:
  - behaviourId: Enemy_Pickpocket_Behavior_0
    behaviourDescription: "\uB2E4\uC74C \uC790\uC2E0\uC5D0\uAC8C 2 \uD134 \uB3D9\uC548
      \uC9C0\uC18D\uB418\uB294 \uC190 \uB300\uC9C0\uB9C8! 1 \uC2A4\uD0DD\uC744 \uAC74\uB2E4."
    associatedStatusEffectIds:
    - Buff_DontTouch
  - behaviourId: Enemy_Pickpocket_Behavior_1
    behaviourDescription: "\uB3C4\uC8FC\uB97C \uC704\uD55C \uC7A5\uC560\uBB3C 3\uAC1C\uB97C
      \uC0DD\uC131\uD55C\uB2E4.\r\n\uB3C4\uC8FC\uB97C \uC704\uD55C \uC7A5\uC560\uBB3C
      : \uB9CC\uC57D \u201C\uC18C\uB9E4\uCE58\uAE30\uBC94\u201D\uC744 \uB300\uC0C1\uC73C\uB85C
      \uD50C\uB808\uC774\uC5B4\uAC00 \uCE74\uB4DC\uB97C \uBC1C\uB3D9\uD560 \uACBD\uC6B0,
      \uC790\uC2E0\uC758 \uCCB4\uB825 1\uC744 \uC904\uC774\uACE0 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C
      \uD53C\uD574 20\uC744 \uC900\uB2E4. (\uCD5C\uB300 4\uAC1C\uAE4C\uC9C0 \uB3D9\uC2DC\uC5D0
      \uC874\uC7AC \uAC00\uB2A5)"
    associatedStatusEffectIds: []
  - behaviourId: Enemy_Pickpocket_Behavior_2
    behaviourDescription: "\uC790\uC2E0\uC5D0\uAC8C \uC774\uBC88 \uC804\uD22C\uB3D9\uC548
      \uC9C0\uC18D\uB418\uB294 \uBE60\uB978 \uB3C4\uC8FC 1\uC2A4\uD0DD \uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4.
      \uD574\uB2F9 \uD589\uB3D9\uC740 1\uD134\uC5D0 \uD55C\uBC88\uB9CC \uBC1C\uB3D9\uD569\uB2C8\uB2E4."
    associatedStatusEffectIds:
    - Buff_QuickEscape
  - behaviourId: Enemy_Pickpocket_Behavior_3
    behaviourDescription: "\uC790\uC2E0\uC758 \uCCB4\uB825\uC744 20 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    associatedStatusEffectIds: []
  - behaviourId: Enemy_Pickpocket_Behavior_4
    behaviourDescription: "\uD50C\uB808\uC774\uC5B4\uC758 \uB2E4\uC74C \uD134 \uCF54\uC2A4\uD2B8\uB97C
      2 \uAC10\uC18C \uC2DC\uD0B5\uB2C8\uB2E4."
    associatedStatusEffectIds: []
  encounterLines:
  - "\uC624\uD638.. \uC774\uAC70 \uB3C8 \uC880 \uB418\uACA0\uB294\uB370?"
