    m_PersistentCalls:
      m_Calls: []
  m_text: "\uBAA8\uB4E0 \uCE74\uB4DC\uC758 \uCF54\uC2A4\uD2B8\uAC00 1 \uAC10\uC18C\uD558\uB294
    \uB300\uC2E0, \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD560 \uB54C\uB9C8\uB2E4, \uD55C\uD134\uB3D9\uC548
    \uC9C0\uC18D\uB418\uB294 \uD589\uB3D9 \uBD88\uAC00 1\uC2A4\uD0DD\uC774 \uAC78\uB9B4
    \uD655\uB960\uC774 \uC99D\uAC00\uD558\uACE0 \uD574\uB2F9 \uD655\uB960\uC5D0 \uB530\uB77C
    \uB514\uBC84\uD504\uAC00 \uAC78\uB9B0\uB2E4. \n(\uD574\uB2F9 \uD655\uB960\uC740
    \uB2E4\uC74C \uC804\uD22C\uB178\uB4DC\uB85C \uC774\uB3D9\uD558\uBA74 \uCD08\uAE30\uD654
    \uB41C\uB2E4.)\n[ \uD655\uB960 : \uCE74\uB4DC 0\uD68C \uC0AC\uC6A9 \uC2DC 5%,
    \uC774\uD6C4 \uAC01 \uCE74\uB4DC \uC0AC\uC6A9\uC2DC \uB9C8\uB2E4 4%\uC529 \uC99D\uAC00
